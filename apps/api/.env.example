# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Database Connection (Same PostgreSQL instance)
DATABASE_URL="postgresql://username:password@localhost:5432/bayanserve?schema=public"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# JWT Shared Key (matches NextAuth AUTH_SECRET)
JWT_SECRET="3h7Dk8Jm5NqR9tY2w4v6z8B1C3D5E7G9"

# Gmail SMTP Configuration
GMAIL_USER="your.email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"



# Public URL of the deployed web app (e.g. https://bayanserve.vercel.app)
# Used for QR code verification links inside generated PDF documents
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recipient for Notification Verification Script
TEST_EMAIL_RECIPIENT=your.test.email@gmail.com

