# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/bayanserve?schema=public"

# ─── NextAuth.js v5 ──────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Gmail SMTP (for OTP emails) ─────────────────────────────────────────────
# Use a Gmail App Password: https://support.google.com/accounts/answer/185833
GMAIL_USER="your.email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ─── Express REST API ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:5000"

# ─── White-label LGU ─────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LGU_NAME="Your Municipality"
NEXT_PUBLIC_DEFAULT_LGU_MUNICIPALITY="Your Municipality"
NEXT_PUBLIC_DEFAULT_LGU_PROVINCE="Your Province"
NEXT_PUBLIC_DEFAULT_LGU_PRIMARY_COLOR="#1a3c6e"
NEXT_PUBLIC_DEFAULT_LGU_PHONE=""
NEXT_PUBLIC_DEFAULT_LGU_EMAIL=""
NEXT_PUBLIC_DEFAULT_LGU_LOGO_URL=""


